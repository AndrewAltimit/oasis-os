 "layers": [
  {
   "id": "hosts",
   "title": "Hosts",
   "blurb": "Binaries and libraries a platform links: the desktop shell, the C ABI for UE5, the PSP USB thin-client host."
  },
  {
   "id": "registry",
   "title": "Registry",
   "blurb": "The built-in app bundle hosts depend on: one AppRegistry of every app crate."
  },
  {
   "id": "coordination",
   "title": "Coordination",
   "blurb": "Dashboard, shell chrome, AppRunner, plugins, scripting, agent. Depends on the app framework but on no app crate."
  },
  {
   "id": "apps",
   "title": "Apps",
   "blurb": "The App trait and the ten app crates; each draws itself through App::draw_windowed."
  },
  {
   "id": "engines",
   "title": "Engines",
   "blurb": "The browser engine and its parser / loader crates, JavaScript, the terminal, video and audio."
  },
  {
   "id": "presentation",
   "title": "Presentation",
   "blurb": "Scene graph, widgets, window manager, skins, vector art, shader wallpapers and the software rasterizer."
  },
  {
   "id": "services",
   "title": "Services",
   "blurb": "Virtual file system, platform services, networking, the MCP server, translations."
  },
  {
   "id": "foundation",
   "title": "Foundation",
   "blurb": "Colors, input events, geometry, errors and the backend traits every platform implements; plus the test doubles."
  },
  {
   "id": "backends",
   "title": "Backends",
   "blurb": "Below the trait boundary: each implements the oasis-types traits for one platform."
  },
  {
   "id": "psp",
   "title": "PSP tools",
   "blurb": "Standalone mipsel-sony-psp crates built one by one with cargo psp: the overlay PRX, recovery, dev loop, Media Engine and USB research."
  }
 ],
