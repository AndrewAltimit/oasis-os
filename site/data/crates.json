 "walks": [
  {
   "id": "frame",
   "title": "A frame",
   "blurb": "From the shell's main loop to pixels on a desktop window, a canvas, a UE5 texture or a PSP screen.",
   "steps": [
    {
     "title": "The shell starts a frame",
     "crates": [
      "oasis-app"
     ],
     "text": "Shell::render calls draw_frame, which clears the back buffer to the skin's background color and, when the skin has a shader wallpaper, shades it and blits it first.",
     "code": [
      "crates/oasis-app/src/shell.rs: Shell::render",
      "crates/oasis-app/src/shell.rs: draw_frame"
     ]
    },
    {
     "title": "Shader wallpaper",
     "crates": [
      "oasis-shader",
      "oasis-backend-sdl"
     ],
     "text": "The SDL shader bridge renders the skin's Shadertoy-style wallpaper (GPU when it can, the CPU implementation otherwise) and blits it under everything else.",
     "code": [
      "crates/oasis-backend-sdl/src/shader_bridge.rs: render_and_blit"
     ]
    },
    {
     "title": "Scene objects",
     "crates": [
      "oasis-sdi",
      "oasis-core"
     ],
     "text": "oasis-core keeps the dashboard, status bar and taskbar as named objects in the SDI registry; SdiRegistry::draw paints them in z-order (or as a base and overlay layer around vector icons).",
     "code": [
      "crates/oasis-app/src/render.rs: update_sdi",
      "crates/oasis-sdi/src/registry/draw.rs: SdiRegistry::draw"
     ]
    },
    {
     "title": "Window chrome",
     "crates": [
      "oasis-wm"
     ],
     "text": "In desktop mode WindowManager::draw_with_clips_overlay draws each window's decorations, then clips to its content rect and hands the content area to a callback.",
     "code": [
      "crates/oasis-wm/src/render.rs: draw_with_clips_overlay"
     ]
    },
    {
     "title": "The app draws itself",
     "crates": [
      "oasis-core",
      "oasis-app-core",
      "oasis-app-calculator"
     ],
     "text": "The callback finds the window's AppRunner, which delegates to the app's App::draw_windowed (here, the Calculator) with the content rect and the active theme.",
     "code": [
      "crates/oasis-core/src/apps/runner.rs: AppRunner::draw_windowed",
      "crates/oasis-app-core/src/app_trait.rs: App::draw_windowed"
     ]
    },
    {
     "title": "Through the trait boundary",
     "crates": [
      "oasis-types",
      "oasis-ui"
     ],
     "text": "Apps and widgets only see &mut dyn SdiBackend: fill_rect, draw_text, blit and the extension-trait defaults. Nothing above this line calls a platform API.",
     "code": [
      "crates/oasis-types/src/backend/sdi_core.rs: SdiCore",
      "crates/oasis-types/src/backend/sdi_backend.rs: SdiBackend"
     ]
    },
    {
     "title": "Pixels on a platform",
     "crates": [
      "oasis-backend-sdl",
      "oasis-backend-wasm",
      "oasis-backend-ue5",
      "oasis-backend-psp"
     ],
